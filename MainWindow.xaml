<Window x:Class="ExilonTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exilon Engine &amp; Studio Tracker v1.0" Height="500" Width="800"
        Background="#111111" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="EXILON" FontSize="22" FontWeight="Bold" Foreground="#D32F2F"/>
            <TextBlock Text=" TRACKER" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text=" [Exilon Studio Official]" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Main Dashboard -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Status Box -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="MOTOR &amp; SISTEM DURUMU" Foreground="#D32F2F" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtEngineVersion" Text="Engine Version: Yükleniyor..." Foreground="#CCCCCC" Margin="0,2"/>
                    <TextBlock x:Name="TxtStatus" Text="Durum: Kontrol ediliyor..." Foreground="#CCCCCC" Margin="0,2"/>
                    <TextBlock x:Name="TxtArchitecture" Text="Mimari: -" Foreground="#CCCCCC" Margin="0,2"/>
                    <Separator Background="#333333" Margin="0,15"/>
                    <Button Content="Açıklamayı Oku (GitHub)" Click="BtnOpenReadme_Click" Background="#D32F2F" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,5"/>
                    <Button Content="Ekip Başvuru Formu" Click="BtnOpenForm_Click" Background="#333333" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- Log / Info View -->
            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="5" Padding="10">
                <ListBox x:Name="LstLogs" Background="Transparent" Foreground="#00FF66" BorderThickness="0" FontFamily="Consolas" FontSize="11"/>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Text="© 2026 Exilon Studio — Burak Dönmez (@burak_fixed)" Foreground="#666666" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>
